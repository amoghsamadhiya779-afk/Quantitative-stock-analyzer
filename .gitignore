# Python / virtual environments
__pycache__/
*.py[cod]
*$py.class
venv/
.venv/
env/
.env

# Jupyter
.ipynb_checkpoints/

# MLOps run output. Trained models (*.keras, *.pkl) ARE committed via Git LFS because
# the deployed API serves them; logs and plots from local runs are not.
mlops_artifacts/logs/*
!mlops_artifacts/logs/.gitkeep
mlops_artifacts/plots/*
!mlops_artifacts/plots/.gitkeep

# Data (too large to commit; the API falls back to a live yfinance fetch)
data/

# Tooling caches
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Frontend
node_env/
frontend/node_modules/
frontend/.next/
frontend/*.tsbuildinfo
frontend/test-results/
frontend/playwright-report/

# OS generated files
.DS_Store
Thumbs.db

# Agent workspaces
.agents/
