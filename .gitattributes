*.h5 filter=lfs diff=lfs merge=lfs -text
*.keras filter=lfs diff=lfs merge=lfs -text
*.png filter=lfs diff=lfs merge=lfs -text
*.pkl filter=lfs diff=lfs merge=lfs -text

# Frontend public assets must NOT be in LFS. Vercel does not fetch LFS objects during
# its build, so an LFS-tracked file under public/ is deployed as its pointer stub and
# every request for it returns a few lines of text instead of an image. These are small
# enough (~5MB total) to live as ordinary blobs.
frontend/public/*.png -filter -diff -merge
frontend/public/assets/*.png -filter -diff -merge
